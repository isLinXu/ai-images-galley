# AI智能相册系统 - 环境变量配置

# 基础配置
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 安全配置
SECRET_KEY=your-secret-key-here-change-in-production
# 可选：设置后，上传/删除/压缩接口需要 Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=

# AI 配置（auto: 有 Key 用真实模型，否则 mock；mock: 强制演示数据；openai: 强制真实调用）
AI_PROVIDER=auto
# 留空则自动使用 mock；填入真实 Key 后启用模型
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
VISION_MODEL=gpt-4o
IMAGE_GEN_MODEL=dall-e-3
AI_TIMEOUT_SECONDS=30
AI_CACHE_TTL_SECONDS=300

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
MAX_IMAGE_DIMENSION=12000
